# Copy to .env.local (development) or .env.production (build) and fill in what you need.
# Every variable is optional; the defaults are noted. Only VITE_* variables reach the app
# (src/lib/env.ts), and they end up in the built JavaScript, so never put secrets here.

# --- Backend --------------------------------------------------------------------------
# Base URL of the INATrace backend. Empty = same origin (app and /api served from one host;
# in development the Vite dev server proxies /api, see API_PROXY_TARGET below).
VITE_API_URL=

# Dev-server proxy target for /api. Read by vite.config.ts from the shell environment,
# not from this file: API_PROXY_TARGET=http://localhost:8080 npm run dev
# API_PROXY_TARGET=http://localhost:8080

# --- App ------------------------------------------------------------------------------
# Name shown in the UI and on printed farmer / collector cards (default: INATrace).
VITE_APP_NAME=INATrace
# Shown in the app version page (default: the Vite mode, e.g. development / production).
VITE_ENVIRONMENT_NAME=

# --- QR codes -------------------------------------------------------------------------
# Public base URL used in QR codes (default: the app's own origin).
VITE_APP_BASE_URL=
# Path segment of QR code links: <base>/<lang>/<path>/<label uuid>/<qr tag> (default: q-cd).
VITE_QR_CODE_BASE_PATH=q-cd

# --- Maps -----------------------------------------------------------------------------
# Street map tiles (default: OpenStreetMap; check its tile usage policy for production).
VITE_MAP_TILES=
VITE_MAP_ATTRIBUTION=
# Satellite view, in order of preference:
#   1. custom tiles below, 2. Mapbox satellite-streets with a token, 3. Esri World Imagery.
VITE_MAP_SATELLITE_TILES=
VITE_MAP_SATELLITE_ATTRIBUTION=
# Public Mapbox access token (pk.…), restricted to your domains in the Mapbox dashboard.
VITE_MAPBOX_ACCESS_TOKEN=

# --- Integrations ---------------------------------------------------------------------
# Beyco marketplace login.
VITE_BEYCO_AUTH_URL=
VITE_BEYCO_CLIENT_ID=
# Token for /api/public/logRequest (scan / page-view logging); logging is off when empty.
VITE_PUBLIC_LOG_TOKEN=
# Google Analytics measurement ID (G-…); loaded only after cookie consent.
VITE_GOOGLE_ANALYTICS_ID=
# Live chat: "rocket" (Rocket.Chat livechat, needs the server below) or "intercom"; empty = off.
VITE_CHAT_APP=
VITE_ROCKET_CHAT_SERVER=
